{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garudust",
  "version": "0.13.6",
  "identifier": "ai.garudust.desktop",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd ../../web && trunk serve --open false",
    "beforeBuildCommand": "cd ../../web && trunk build --release"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/garudust-server"
    ]
  }
}